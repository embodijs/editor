		"eslint-plugin-svelte": "^3.12.4",
		"formsnap": "^2.0.1",
		"globals": "^16.4.0",
		"jsdom": "^27.0.0",
		"playwright": "^1.56.0",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"svelte": "^5.39.11",
		"svelte-check": "^4.3.3",
		"sveltekit-superforms": "^2.27.2",
		"tailwind-merge": "^3.3.1",
