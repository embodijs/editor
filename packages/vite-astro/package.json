{
  "name": "@embodi/vite-astro-cms",
  "module": "dist/plugin.js",
  "types": "dist/plugin.d.ts",
  "type": "module",
  "version": "0.7.1",
  "scripts": {
    "test": "vitest",
    "build:code": "tsup --config tsup-code.config.ts",
    "build:plugin": "tsup --config tsup.config.ts",
    "build": "bun run build:code && bun run build:plugin",
    "prepublishOnly": "bun run build && bun run publint"
  },
  "files": [
    "client.d.ts",
    "dist",
    "code"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/plugin.d.ts",
        "default": "./dist/plugin.js"
      },
      "require": {
        "types": "./dist/plugin.d.cts",
        "default": "./dist/plugin.cjs"
      }
    },
    "./content": {
      "import": {
        "types": "./code/content.d.ts",
        "default": "./code/content.js"
      }
    },
    "./client": {
      "import": {
        "types": "./client.d.ts"
      }
    }
  },
  "dependencies": {
    "@embodi/cms": "workspace:*",
    "minimatch": "^10.1.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "esbuild-plugin-raw": "^0.3.0",
    "publint": "^0.3.15",
    "tsup": "^8.5.1",
    "type-fest": "^5.2.0",
    "valibot": "^1.1.0"
  },
  "peerDependencies": {
    "typescript": "^5",
    "vite": "^7",
    "zod": "^4",
    "astro": "^5"
  },
  "license": "Apache-2.0"
}
